import ifj26.*

@main def m(): Unit =
  val a = toInt(3.99)
  print(a)
  print("|")
  val b = toInt(-3.99)
  print(b)
  print("|")
  val c = toStr(5)
  print(c)
  print("|")
  val d = toStr(2.5)
  print(d)
  print("|")
  val e = toStr("x")
  print(e)
  print("|")
  val f = toStr(-7)
  print(f)
  print("|")
  val g = toInt(1e10)
  print(g)
  print("|")
  val h = toInt(5)
  print(h)
  print("|")
  val i = toStr(1.005e2)
  print(i)
  print("\n")
