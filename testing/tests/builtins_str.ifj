import ifj26.*

@main def m(): Unit =
  val s = "abcd"
  val a = subStr(s, 1, 3)
  print(a)
  print("|")
  val b = subStr(s, 0, 4)
  print(b)
  print("|")
  val c = subStr(s, 2, 2)
  print(c)
  print("|")
  val l = strLength(s)
  print(l)
  print("|")
  val e = ""
  val l2 = strLength(e)
  print(l2)
  print("|")
  val o1 = ord(s, 0)
  print(o1)
  print("|")
  val o2 = ord(e, 0)
  print(o2)
  print("|")
  val o3 = ord(s, 4)
  print(o3)
  print("|")
  val o4 = ord(s, -1)
  print(o4)
  print("|")
  val ch = chr(97)
  print(ch)
  print("|")
  val ch0 = chr(0)
  val l3 = strLength(ch0)
  print(l3)
  print("\n")
